# Export APP_ENV=local in the shell before running RepoScout. APP_ENV is intentionally
# required before this optional local file is loaded.
DATABRICKS_CONFIG_PROFILE=reposcout
GITHUB_TOKEN=github_pat_replace_me
GITHUB_API_URL=https://api.github.com

# Lakebase connection parameters from the Lakebase Connect dialog.
PGHOST=your-endpoint.database.cloud.databricks.com
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=your.email@example.com
PGSSLMODE=require
LAKEBASE_ENDPOINT=projects/project-id/branches/branch-id/endpoints/endpoint-id

# Optional generation. Semantic search works without an OpenRouter key.
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-replace-me
LLM_MODEL_NAME=openrouter/free
LLM_REQUEST_TIMEOUT=45
LLM_MAX_OUTPUT_TOKENS=2000

# Optional Agent-backed Ask experience. Uses the Databricks CLI profile locally.
SUPERVISOR_ENDPOINT_NAME=mas-replace-me-endpoint
SUPERVISOR_REQUEST_TIMEOUT_SECONDS=120
SUPERVISOR_TASK_TIMEOUT_SECONDS=300

# Optional tuning.
SEARCH_MIN_SIMILARITY=0.25
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_SECONDS=30
GITHUB_README_CONCURRENCY=8
GITHUB_RETRY_ATTEMPTS=2
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_MAX_LIFETIME_SECONDS=3300
DB_POOL_TIMEOUT_SECONDS=30
